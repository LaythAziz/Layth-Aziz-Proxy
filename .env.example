# Vercel API secrets (set these in Vercel Project Settings > Environment Variables)
ADMIN_API_TOKEN=replace_with_64_hex_characters
PROXY_SECRET_ENCRYPTION_KEY=replace_with_64_hex_characters
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
HETZNER_API_TOKEN=replace_with_hetzner_cloud_api_token

# Optional Hetzner defaults
HETZNER_LOCATION=fsn1
HETZNER_SERVER_TYPE=cx22
HETZNER_IMAGE=ubuntu-24.04

# Optional: only for running the Docker MTProxy service directly on a VPS
MT_PROXY_SECRET=replace_with_32_hex_characters
MT_PROXY_PORT=443
MT_PROXY_WORKERS=1
